# Base de datos
DATABASE_URL="postgresql://user:password@localhost:5432/habito?schema=public"

# Clave para firmar la cookie de sesión.
# Genérala con:  openssl rand -base64 32
# Si falta, se usa DATABASE_URL como material de firma para no dejar la app
# inaccesible, pero conviene definirla aparte.
AUTH_SECRET=""

# PIN inicial. Solo se usa la primera vez, para sembrar el hash en la tabla
# settings. A partir de ahí se cambia desde Ajustes.
APP_PIN="0001"
